{"name":"Yesbook","short_name":"Yesbook","description":"Yesbook builds custom, branded booking apps for salons, barbers, sports courts, spas, clinics, tutors and trainers across the GTA. Online and in-store booking, reminders, client records and an AI phone receptionist.","start_url":"/","display":"standalone","background_color":"#ffffff","theme_color":"#12a150","icons":[{"src":"/icon.svg","sizes":"any","type":"image/svg+xml"},{"src":"/apple-icon.png","sizes":"1024x1024","type":"image/png"}]}